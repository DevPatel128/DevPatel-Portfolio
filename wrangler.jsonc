{
  // Cloudflare Workers configuration — Dev Patel portfolio
  // Static site served from ./public, contact API handled by ./worker/index.js
  "name": "info",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-24",

  // Free *.workers.dev address. Preview URLs are OFF: they publish a full,
  // unauthenticated copy of the site per version, and their hostname
  // (<version>-<worker>.<subdomain>.workers.dev) is indistinguishable from
  // production to a _headers rule — so they cannot be selectively noindexed.
  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true
  },

  // Only files inside ./public are ever published.
  // Engineering docs at the repo root are therefore unreachable from the web.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Permanent record of every contact submission. Reachable only through this
  // binding — there is no public endpoint and no client-side key to leak.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-contact",
      "database_id": "f969cf74-2654-4524-ac86-b95f4cc67fb4"
    }
  ],

  // Per-IP rate limiting for the contact endpoint
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "02434550c7fc4dea95584e0c0a0e8076"
    }
  ]
}
