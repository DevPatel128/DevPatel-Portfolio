{
  "name": "devpatel-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Dev Patel portfolio — static site + contact API on Cloudflare Workers, backed by Supabase.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
