# ─────────────────────────────────────────────────────────────────────────────
# Dev Patel portfolio — environment variables
#
# Local development:  cp .env.example .dev.vars   (wrangler dev reads .dev.vars)
# Production:         wrangler secret put <NAME>  (or the Cloudflare dashboard)
# CI:                 GitHub → Settings → Secrets and variables → Actions
#
# .dev.vars and .env are gitignored. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────


# ── SERVER-ONLY — Cloudflare Worker secrets ──────────────────────────────────
# These live only in the Worker runtime and never reach the browser.

# Supabase Postgres — permanent record of every contact submission.
# Use the PUBLISHABLE (anon) key, never the service_role key: the table's RLS
# policy grants INSERT only, so an exposed anon key still cannot read messages.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Resend — transactional email (preferred provider).
# All three must be set for Resend to be used. CONTACT_FROM_EMAIL must be on a
# domain verified in Resend; the display-name form is supported.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Dev Patel <hello@your-verified-domain.tld>

# FormSubmit — legacy email fallback. Used only when Resend is not configured.
# Remove this once Resend is live.
FORMSUBMIT_TOKEN=

# Cloudflare Turnstile — bot protection on the contact form.
# Set the secret to turn server-side verification on. Leave both unset and the
# form falls back to the honeypot plus the per-IP KV rate limit.
TURNSTILE_SECRET_KEY=


# ── CLIENT-SAFE — served to the browser from GET /api/config ─────────────────
# Public by design. Stored as a Worker secret purely to keep account-specific
# values out of the repository; it is not confidential.

TURNSTILE_SITE_KEY=


# ── CI ONLY — GitHub Actions secrets, never in this file at runtime ──────────
# CLOUDFLARE_API_TOKEN   Workers Scripts:Edit + Workers KV Storage:Edit
# CLOUDFLARE_ACCOUNT_ID  Cloudflare dashboard → Workers & Pages → Account ID
